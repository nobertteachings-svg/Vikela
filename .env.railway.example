# Vikela Railway production — copy into Railway service Variables (Raw Editor)
# Web: https://web-production-1c70bf.up.railway.app
# API: https://api-production-eec4.up.railway.app

WEB_URL=https://web-production-1c70bf.up.railway.app
API_URL=https://api-production-eec4.up.railway.app

# ── API service variables ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_URL=https://api-production-eec4.up.railway.app
APP_URL=https://web-production-1c70bf.up.railway.app
CORS_ALLOWED_ORIGINS=https://web-production-1c70bf.up.railway.app

DATABASE_URL=${{Postgres.DATABASE_URL}}
DIRECT_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
ENCRYPTION_KEY=

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
ALLOW_DEMO_INTEGRATIONS=false
API_RATE_LIMIT_MAX=300
DISABLE_SCAN_WORKER=false

GITHUB_REDIRECT_URI=https://web-production-1c70bf.up.railway.app/api/auth/github/callback

# Clerk webhook: https://api-production-eec4.up.railway.app/api/v1/webhooks/clerk

