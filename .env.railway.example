# Vikela Railway, copy variables into each service (Railway → Variables → Raw Editor)
# Replace YOUR_WEB / YOUR_API with your generated Railway public URLs.

# ══════════════════════════════════════════════════════════════════════════════
# API SERVICE  (Settings → Config file path: apps/api/railway.json)
# Root Directory must be EMPTY (repo root).
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3001

# Web app public URL (browser)
APP_URL=https://YOUR_WEB.up.railway.app
# API public URL (this service)
API_URL=https://YOUR_API.up.railway.app
CORS_ALLOWED_ORIGINS=https://YOUR_WEB.up.railway.app

# Wire to Railway database services (use References in Railway UI)
DATABASE_URL=${{Postgres.DATABASE_URL}}
DIRECT_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Generate once: openssl rand -hex 32
ENCRYPTION_KEY=

# Clerk, same application as Web service
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Local-dev only, keep false in production. Never enable demo integrations on Railway.
ALLOW_DEMO_INTEGRATIONS=false
API_RATE_LIMIT_MAX=300
DISABLE_SCAN_WORKER=false

# GitHub App. MUST be public (Advanced → Make public) for customer install
# https://github.com/apps/YOUR_GITHUB_APP_SLUG
# Setup + Callback URL: https://<web>/api/auth/github/callback
# Webhook URL: https://<api>/api/v1/webhooks/github
# GITHUB_APP_PRIVATE_KEY = full PEM (BEGIN PRIVATE KEY), escape newlines as \n on Railway
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_GITHUB_APP_PEM\n-----END RSA PRIVATE KEY-----\n
GITHUB_APP_SLUG=YOUR_GITHUB_APP_SLUG
GITHUB_WEBHOOK_SECRET=replace-me

# Client ID/secret from the same GitHub App (OAuth fallback if PEM missing)
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=replace-me
GITHUB_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/github/callback

# Clerk webhook endpoint (configure in Clerk dashboard):
# https://YOUR_API.up.railway.app/api/v1/webhooks/clerk

# ── Coming soon integrations (fill when enabling Connect) ────────────────────
# Cloud Phase 3
DO_CLIENT_ID=
DO_CLIENT_SECRET=
DO_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/digitalocean/callback
CF_CLIENT_ID=
CF_CLIENT_SECRET=
CF_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/cloudflare/callback
ORACLE_TENANCY_OCID=
ORACLE_USER_OCID=
ORACLE_FINGERPRINT=
ORACLE_PRIVATE_KEY=
ORACLE_REGION=us-ashburn-1
ORACLE_CLIENT_ID=
ORACLE_CLIENT_SECRET=
ORACLE_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/oracle/callback
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_REGION=cn-hangzhou
ALIBABA_CLIENT_ID=
ALIBABA_CLIENT_SECRET=
ALIBABA_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/alibaba/callback

# Auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/auth0/callback
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# Observability
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
GRAFANA_URL=
GRAFANA_API_TOKEN=
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=
PAGERDUTY_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/pagerduty/callback
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_USER_API_KEY=
NEW_RELIC_REGION=US

# Communication
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/slack/callback
MICROSOFT_TEAMS_CLIENT_ID=
MICROSOFT_TEAMS_CLIENT_SECRET=
MICROSOFT_TEAMS_TENANT_ID=
MICROSOFT_TEAMS_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/microsoft-teams/callback

# Public API URL for provider webhooks
API_PUBLIC_URL=https://YOUR_API.up.railway.app

# ══════════════════════════════════════════════════════════════════════════════
# WEB SERVICE  (Settings → Config file path: apps/web/railway.json)
# Root Directory must be EMPTY (repo root).
# ══════════════════════════════════════════════════════════════════════════════

# NODE_ENV=production

# Required, baked in at BUILD time; redeploy Web after changing
# NEXT_PUBLIC_API_URL=https://YOUR_API.up.railway.app

# Optional, server-side only; use Railway private domain for faster internal calls:
# API_URL=http://${{API.RAILWAY_PRIVATE_DOMAIN}}:3001

# Clerk, required on Web (middleware + client)
# CLERK_SECRET_KEY=sk_test_REPLACE_ME
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/connect-repos

# ══════════════════════════════════════════════════════════════════════════════
# POSTGRES + REDIS, no env vars needed on these services; link via References above.
# ══════════════════════════════════════════════════════════════════════════════
