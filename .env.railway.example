# Vikela Railway — copy variables into each service (Railway → Variables → Raw Editor)
# Replace example domains with your generated Railway public URLs.

# ══════════════════════════════════════════════════════════════════════════════
# API SERVICE  (Settings → Config file path: apps/api/railway.json)
# Root Directory must be EMPTY (repo root).
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3001

# Web app public URL (browser)
APP_URL=https://web-production-1c70bf.up.railway.app
# API public URL (this service)
API_URL=https://api-production-eec4.up.railway.app
CORS_ALLOWED_ORIGINS=https://web-production-1c70bf.up.railway.app

# Wire to Railway database services (use References in Railway UI)
DATABASE_URL=${{Postgres.DATABASE_URL}}
DIRECT_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Generate once: openssl rand -hex 32
ENCRYPTION_KEY=

# Clerk — same application as Web service
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

ALLOW_DEMO_INTEGRATIONS=false
API_RATE_LIMIT_MAX=300
DISABLE_SCAN_WORKER=false

# OAuth callbacks go through the Web app
GITHUB_REDIRECT_URI=https://web-production-1c70bf.up.railway.app/api/auth/github/callback

# Clerk webhook endpoint (configure in Clerk dashboard):
# https://api-production-eec4.up.railway.app/api/v1/webhooks/clerk

# ══════════════════════════════════════════════════════════════════════════════
# WEB SERVICE  (Settings → Config file path: apps/web/railway.json)
# Root Directory must be EMPTY (repo root).
# ══════════════════════════════════════════════════════════════════════════════

# NODE_ENV=production

# Required — baked in at BUILD time; redeploy Web after changing
# NEXT_PUBLIC_API_URL=https://api-production-eec4.up.railway.app

# Optional — server-side only; use Railway private domain for faster internal calls:
# API_URL=http://${{API.RAILWAY_PRIVATE_DOMAIN}}:3001

# Clerk — required on Web (middleware + client)
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/connect-repos

# ══════════════════════════════════════════════════════════════════════════════
# POSTGRES + REDIS — no env vars needed on these services; link via References above.
# ══════════════════════════════════════════════════════════════════════════════
