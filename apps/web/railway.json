{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "bash scripts/railway-validate-env.sh web && npm run build -w @vikela/shared && npm run build -w @vikela/web",
    "watchPatterns": ["apps/web/**", "packages/shared/**", "scripts/railway-validate-env.sh"]
  },
  "deploy": {
    "startCommand": "npm run start -w @vikela/web",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}
