generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique
  clerkOrgId           String         @unique
  plan                 Plan           @default(FREE)
  /** Stripe subscription status mirror, source of truth for paid access. */
  billingStatus        BillingStatus  @default(FREE)
  /** STRIPE = webhook-driven; MANUAL = sales/Enterprise override (webhooks must not clobber). */
  planSource           PlanSource     @default(STRIPE)
  /** monthly | annual when billed via Stripe; null for free/manual. */
  billingInterval      String?
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?
  settings             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  members              Member[]
  integrations         Integration[]
  repositories         Repository[]
  cloudAccounts        CloudAccount[]
  frameworks           OrgFramework[]
  controls             OrgControl[]
  gaps                 Gap[]
  evidence             Evidence[]
  policies             Policy[]
  scans                Scan[]
  vendors              Vendor[]
  risks                Risk[]
  knowledgeChunks      KnowledgeChunk[]
  copilotThreads       CopilotThread[]
  trainingModules      TrainingModule[]
  trainingAssignments  TrainingAssignment[]
  questionnaires       Questionnaire[]
  apiKeys              ApiKey[]
  orgWebhooks          OrgWebhook[]
  auditEvents          AuditEvent[]
  pendingInvites       PendingInvite[]
}

model Member {
  id        String   @id @default(cuid())
  orgId     String
  clerkId   String
  email     String
  name      String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  org                  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  trainingAssignments  TrainingAssignment[]
  ownedRisks           Risk[]

  @@unique([orgId, clerkId])
}

model PendingInvite {
  id                  String    @id @default(cuid())
  orgId               String
  email               String
  role                Role
  clerkInvitationId   String?
  expiresAt           DateTime
  acceptedAt          DateTime?
  createdAt           DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId, expiresAt])
}

model Integration {
  id           String              @id @default(cuid())
  orgId        String
  provider     IntegrationProvider
  category     IntegrationCategory
  name         String
  externalId   String?
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  scopes       String[]
  metadata     Json?
  isActive     Boolean             @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repositories  Repository[]
  cloudAccounts CloudAccount[]
  scans         Scan[]

  @@unique([orgId, provider, externalId])
}

model Repository {
  id            String   @id @default(cuid())
  orgId         String
  integrationId String
  externalId    String
  name          String
  fullName      String
  cloneUrl      String
  defaultBranch String   @default("main")
  isPrivate     Boolean  @default(true)
  isActive      Boolean  @default(true)
  lastScannedAt DateTime?
  createdAt     DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integration Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  scans       Scan[]
  gaps        Gap[]

  @@unique([integrationId, externalId])
}

model CloudAccount {
  id            String        @id @default(cuid())
  orgId         String
  integrationId String
  provider      CloudProvider
  accountId     String
  accountName   String
  region        String?
  environment   Environment   @default(PRODUCTION)
  isActive      Boolean       @default(true)
  lastScannedAt DateTime?
  createdAt     DateTime      @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integration Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  scans       Scan[]
  gaps        Gap[]

  @@unique([orgId, provider, accountId])
}

model Framework {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  version     String
  isActive    Boolean @default(true)

  controls      ControlFramework[]
  orgFrameworks OrgFramework[]
}

model OrgFramework {
  id          String          @id @default(cuid())
  orgId       String
  frameworkId String
  status      FrameworkStatus @default(IN_PROGRESS)
  score       Int             @default(0)
  startedAt   DateTime        @default(now())
  targetDate  DateTime?

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  framework Framework    @relation(fields: [frameworkId], references: [id])

  @@unique([orgId, frameworkId])
}

model Control {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  description     String
  category        String
  guidance        String
  testProcedure   String
  autoSatisfiedBy String[] @default([])

  frameworks  ControlFramework[]
  orgControls OrgControl[]
  gaps        Gap[]
}

model ControlFramework {
  controlId   String
  frameworkId String
  requirement String

  control   Control   @relation(fields: [controlId], references: [id], onDelete: Cascade)
  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@id([controlId, frameworkId])
}

model OrgControl {
  id        String        @id @default(cuid())
  orgId     String
  controlId String
  status    ControlStatus @default(NOT_STARTED)
  ownerId   String?
  notes     String?
  updatedAt DateTime      @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  control  Control      @relation(fields: [controlId], references: [id])
  evidence Evidence[]

  @@unique([orgId, controlId])
}

model Scan {
  id             String     @id @default(cuid())
  orgId          String
  integrationId  String?
  repoId         String?
  cloudAccountId String?
  parentScanId   String?
  scanType       ScanType
  commitSha      String?
  prNumber       Int?
  branch         String?
  status         ScanStatus @default(PENDING)
  score          Int?
  totalChecks    Int        @default(0)
  passedChecks   Int        @default(0)
  isLiteScan     Boolean    @default(false)
  startedAt      DateTime   @default(now())
  completedAt    DateTime?

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integration  Integration?  @relation(fields: [integrationId], references: [id])
  repo         Repository?   @relation(fields: [repoId], references: [id])
  cloudAccount CloudAccount? @relation(fields: [cloudAccountId], references: [id])
  parent       Scan?         @relation("ScanChildren", fields: [parentScanId], references: [id], onDelete: SetNull)
  children     Scan[]        @relation("ScanChildren")
  gaps         Gap[]

  @@index([orgId, parentScanId])
}

model Gap {
  id             String         @id @default(cuid())
  orgId          String
  scanId         String?
  repoId         String?
  cloudAccountId String?
  controlId      String?
  title          String
  description    String
  severity       Severity       @default(MEDIUM)
  status         GapStatus      @default(OPEN)
  source         GapSource
  filePath       String?
  lineNumber     Int?
  codeSnippet    String?
  cloudProvider  CloudProvider?
  resourceType   String?
  resourceId     String?
  region         String?
  remediation    String
  isSample       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scan         Scan?         @relation(fields: [scanId], references: [id])
  repo         Repository?   @relation(fields: [repoId], references: [id])
  cloudAccount CloudAccount? @relation(fields: [cloudAccountId], references: [id])
  control      Control?      @relation(fields: [controlId], references: [id])
}

model Evidence {
  id              String         @id @default(cuid())
  orgId           String
  controlId       String?
  title           String
  description     String?
  type            EvidenceType
  source          EvidenceSource
  fileUrl         String?
  fileKey         String?
  mimeType        String?
  /** Uploaded file size in bytes (null for metadata-only evidence). */
  sizeBytes       Int?
  collectedAt     DateTime       @default(now())
  expiresAt       DateTime?
  isAutoCollected Boolean        @default(false)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  control OrgControl?  @relation(fields: [controlId], references: [id])
}

model Policy {
  id         String       @id @default(cuid())
  orgId      String
  title      String
  type       PolicyType
  content    String       @db.Text
  version    Int          @default(1)
  status     PolicyStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model KnowledgeChunk {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  content   String   @db.Text
  source    String
  sourceId  String?
  embedding Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, source])
}

model TrainingModule {
  id          String               @id @default(cuid())
  orgId       String
  name        String
  description String               @db.Text
  framework   String?
  /** Built-in curriculum key from course-catalog (null = custom module). */
  contentKey  String?
  durationMin Int                  @default(45)
  dueAt       DateTime?
  completed   Int                  @default(0)
  assigned    Int                  @default(0)
  status      TrainingModuleStatus @default(ON_TRACK)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments TrainingAssignment[]

  @@unique([orgId, contentKey])
  @@index([orgId])
}

model TrainingAssignment {
  id          String                 @id @default(cuid())
  orgId       String
  memberId    String
  moduleId    String
  status      TrainingProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  org    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([memberId, moduleId])
  @@index([orgId])
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  keyPrefix  String
  keyHash    String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrgWebhook {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  url       String
  events    String[]
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model Questionnaire {
  id        String              @id @default(cuid())
  orgId     String
  vendorId  String?
  title     String
  status    QuestionnaireStatus @default(DRAFT)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  org    Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  items  QuestionnaireItem[]

  @@index([orgId])
  @@index([vendorId])
}

model QuestionnaireItem {
  id              String           @id @default(cuid())
  questionnaireId String
  question        String           @db.Text
  category        String           @default("")
  suggestedAnswer String?          @db.Text
  finalAnswer     String?          @db.Text
  status          ItemReviewStatus @default(PENDING)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
}

model CopilotThread {
  id        String           @id @default(cuid())
  orgId     String
  title     String           @default("New conversation")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  CopilotMessage[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model CopilotMessage {
  id         String        @id @default(cuid())
  threadId   String
  role       String
  content    String        @db.Text
  citations  Json?
  createdAt  DateTime      @default(now())

  thread CopilotThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model Vendor {
  id                  String       @id @default(cuid())
  orgId               String
  name                String
  website             String?
  category            String
  riskLevel           RiskLevel    @default(MEDIUM)
  reviewStatus        ReviewStatus @default(PENDING)
  lastReviewed        DateTime?
  notes               String?
  owner               String?
  dataAccess          String?
  contractRenewal     DateTime?
  score               Int?
  questionnaireStatus String?
  documents           Json?
  subprocessors       Json?
  dataProcessing      Boolean      @default(false)
  soc2Certified       Boolean      @default(false)
  createdAt           DateTime     @default(now())

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  questionnaires Questionnaire[]

  @@index([orgId])
}

model Risk {
  id           String     @id @default(cuid())
  orgId        String
  title        String
  description  String
  category     String     @default("Operational")
  likelihood   Int
  impact       Int
  score        Int
  status       RiskStatus @default(OPEN)
  ownerId      String?
  mitigation   String?
  nextReviewAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner Member?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([ownerId])
}

enum Plan {
  FREE
  SOLO
  STARTER
  GROWTH
  ENTERPRISE
}

enum BillingStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  COMPED
}

enum PlanSource {
  STRIPE
  MANUAL
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  AUDITOR
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum FrameworkStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  CERTIFIED
}

enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  NEEDS_REVIEW
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ScanType {
  CODE
  CLOUD
  IDENTITY
  FULL
}

enum GapStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum GapSource {
  CODE
  IAM
  NETWORK
  ENCRYPTION
  LOGGING
  BACKUP
  MONITORING
}

enum CloudProvider {
  AWS
  AZURE
  GCP
  DIGITALOCEAN
  CLOUDFLARE
  ORACLE
  ALIBABA
}

enum IntegrationProvider {
  GITHUB
  GITLAB
  BITBUCKET
  AWS
  AZURE
  GCP
  DIGITALOCEAN
  CLOUDFLARE
  ORACLE
  ALIBABA
  OKTA
  AZURE_AD
  GOOGLE_WORKSPACE
  AUTH0
  JUMPCLOUD
  DATADOG
  GRAFANA
  PAGERDUTY
  NEW_RELIC
  CLOUDWATCH
  JIRA
  LINEAR
  SLACK
  MICROSOFT_TEAMS
}

enum IntegrationCategory {
  GIT
  CLOUD
  IDENTITY
  OBSERVABILITY
  PROJECT_MANAGEMENT
  COMMUNICATION
}

enum EvidenceType {
  SCREENSHOT
  LOG
  EXPORT
  POLICY
  CONFIG
  CERTIFICATE
  OTHER
}

enum EvidenceSource {
  MANUAL
  AUTO_GITHUB
  AUTO_GITLAB
  AUTO_BITBUCKET
  AUTO_AWS
  AUTO_AZURE
  AUTO_GCP
  AUTO_DO
  AUTO_CLOUDFLARE
  AUTO_OCI
  AUTO_ALIBABA
  AUTO_OKTA
  AUTO_AZURE_AD
  AUTO_GOOGLE_WORKSPACE
  AUTO_AUTH0
  AUTO_JUMPCLOUD
}

enum PolicyType {
  ACCESS_CONTROL
  INCIDENT_RESPONSE
  CHANGE_MANAGEMENT
  DATA_RETENTION
  VENDOR_MANAGEMENT
  ACCEPTABLE_USE
  DISASTER_RECOVERY
  AI_GOVERNANCE
}

enum PolicyStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
  CLOSED
}

enum TrainingModuleStatus {
  ON_TRACK
  AT_RISK
  COMPLETE
  OVERDUE
}

enum QuestionnaireStatus {
  DRAFT
  IN_REVIEW
  COMPLETE
}

enum ItemReviewStatus {
  PENDING
  APPROVED
  EDIT
  SKIP
}

enum TrainingProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  OVERDUE
}
