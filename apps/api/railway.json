{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build -w @vikela/shared && npm run build -w @vikela/api",
    "watchPatterns": ["apps/api/**", "packages/**", "scripts/railway-start-api.sh"]
  },
  "deploy": {
    "startCommand": "bash scripts/railway-start-api.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}
