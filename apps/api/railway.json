{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "bash ../../scripts/railway-build-api.sh",
    "watchPatterns": ["apps/api/**", "packages/**", "scripts/railway-build-api.sh"]
  },
  "deploy": {
    "startCommand": "bash ../../scripts/railway-start-api.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}
