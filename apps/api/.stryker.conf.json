{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "This config is for mutation testing",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/db/**",
    "!src/load-env.ts"
  ],
  "testRunner": "command",
  "testRunnerCommand": "npm run test",
  "coverageAnalysis": "perTest",
  "reporters": [
    "html",
    "json",
    "progress"
  ],
  "thresholds": {
    "high": 80,
    "low": 60
  },
  "timeoutMS": 60000,
  "concurrency": 2
}
