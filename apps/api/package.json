{
  "name": "@vikela/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../.env tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:railway": "prisma migrate deploy && node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "DOTENV_CONFIG_PATH=../../.env prisma db push",
    "db:migrate": "DOTENV_CONFIG_PATH=../../.env prisma migrate deploy",
    "db:migrate:dev": "DOTENV_CONFIG_PATH=../../.env prisma migrate dev",
    "db:seed": "DOTENV_CONFIG_PATH=../../.env tsx src/db/seed.ts",
    "test": "node --import tsx --test $(find src/__tests__ -name '*.test.ts')",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=html node --import tsx --test $(find src/__tests__ -name '*.test.ts')",
    "test:mutation": "stryker run",
    "test:security": "npm audit || (npm audit --audit-level=high && echo 'npm audit completed with warnings')",
    "lint:security": "npm audit --audit-level=high || true",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-cloudtrail": "^3.700.0",
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-guardduty": "^3.700.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@aws-sdk/types": "^3.700.0",
    "@clerk/fastify": "^2.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^8.45.0",
    "@vikela/shared": "file:../../packages/shared",
    "archiver": "^8.0.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "posthog-node": "^5.35.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.10.2",
    "c8": "^10.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^3.0.1",
    "prisma": "^6.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "stryker-cli": "^1.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
