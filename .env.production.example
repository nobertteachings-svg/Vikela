# Vikela production environment, copy to your host (Vercel / Railway / etc.)
# Never commit real secrets. Generate ENCRYPTION_KEY: openssl rand -hex 32

NODE_ENV=production

# ── URLs (required) ──────────────────────────────────────────────────────────
APP_URL=https://YOUR_WEB.up.railway.app
API_URL=https://YOUR_API.up.railway.app
NEXT_PUBLIC_API_URL=https://YOUR_API.up.railway.app
CORS_ALLOWED_ORIGINS=https://YOUR_WEB.up.railway.app

# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vikela?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/vikela
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# ── Encryption (required) ────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ── Clerk auth (required in production) ──────────────────────────────────────
# Use LIVE keys from https://dashboard.clerk.com → API Keys → Production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_SECRET_KEY=sk_live_
CLERK_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/connect-repos

# ── Production safety (required) ─────────────────────────────────────────────
ALLOW_DEMO_INTEGRATIONS=false
# Do NOT set VIKELA_DEV_ORG_SLUG in production
# Do NOT set INTERNAL_API_SECRET for user-facing writes, use Clerk JWT

API_RATE_LIMIT_MAX=300
PORT=3001

# ── GitHub (recommended) ─────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://YOUR_WEB.up.railway.app/api/auth/github/callback

# ── Billing (recommended for paid launch) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_SOLO=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_GROWTH_ANNUAL=

# ── Email (recommended) ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@yourdomain.com

# ── Evidence storage (recommended) ─────────────────────────────────────────────
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=vikela-evidence-prod

# ── AI / Copilot (optional) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_API_KEY=

# ── Cloud scanning (optional) ────────────────────────────────────────────────
AWS_VIKELA_ACCOUNT_ID=
AWS_VIKELA_ACCESS_KEY_ID=
AWS_VIKELA_SECRET_ACCESS_KEY=
AWS_EXTERNAL_ID=vikela-scanner
CLOUD_SCAN_CRON=0 2 * * *
IDENTITY_SCAN_CRON=0 3 * * *
