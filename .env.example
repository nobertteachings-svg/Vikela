# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public URL providers use for webhooks (ngrok / production API). Leave empty for local-only.
API_PUBLIC_URL=
# Generate once: openssl rand -hex 32
ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vikela
# Supabase: use pooler for DATABASE_URL; DIRECT_URL = session pooler :5432 (see Supabase → Connect)
DIRECT_URL=
REDIS_URL=redis://localhost:6379

# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Must be sk_test_.. / sk_live_.. (NOT whsec_, that is the webhook secret)
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Clerk Dashboard → Webhooks → endpoint signing secret (whsec_..)
# Local: ngrok http 3000 then URL = $APP_URL/api/v1/webhooks/clerk (Next proxies to API)
# CLERK_WEBHOOK_SECRET is aliased to CLERK_WEBHOOK_SIGNING_SECRET for @clerk/backend
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME
# Playwright authenticated e2e (use +clerk_test email to suppress Clerk emails)
E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=
# Local-dev only: allow demo integration tokens. Never set true in production / Railway.
ALLOW_DEMO_INTEGRATIONS=false
# Optional server-to-server secret (Next.js → API without user session)
INTERNAL_API_SECRET=
# Dev only: org slug for Clerk-less local API calls. Required for local seed flows (often "demo").
# Never relied on as a silent production fallback, leave unset in production.
VIKELA_DEV_ORG_SLUG=demo
API_RATE_LIMIT_MAX=300
# Comma-separated extra CORS origins for staging/production web URLs
CORS_ALLOWED_ORIGINS=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/connect-repos
# Clerk Core 2+: use FORCE/FALLBACK (AFTER_SIGN_* is ignored → defaults to /)
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding/connect-repos
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/connect-repos

# AI
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Git Providers. GitHub App must be PUBLIC for customer install (Railway-style)
# Dashboard: https://github.com/settings/apps/<GITHUB_APP_SLUG> → Make public + set Setup/Callback/Webhook URLs
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
# Full PEM from GitHub App → Generate private key (not the SHA256 fingerprint)
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_GITHUB_APP_PEM\n-----END RSA PRIVATE KEY-----\n
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_APP_SLUG=YOUR_GITHUB_APP_SLUG
# Client ID/secret from the GitHub App (OAuth fallback when PEM missing)
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=replace-me
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

GITLAB_APP_ID=YOUR_GITLAB_APP_ID
GITLAB_APP_SECRET=replace-me
GITLAB_WEBHOOK_SECRET=replace-me
GITLAB_REDIRECT_URI=http://localhost:3000/api/auth/gitlab/callback

BITBUCKET_CLIENT_ID=YOUR_BITBUCKET_CLIENT_ID
BITBUCKET_CLIENT_SECRET=replace-me
BITBUCKET_WEBHOOK_SECRET=replace-me
BITBUCKET_REDIRECT_URI=http://localhost:3000/api/auth/bitbucket/callback

# Cloud. Vikela account for AWS AssumeRole only
# Vikela platform AWS (AssumeRole into customer accounts). ACCESS_KEY must be AKIA…/ASIA…, not the account id.
AWS_VIKELA_ACCOUNT_ID=
AWS_VIKELA_ACCESS_KEY_ID=
AWS_VIKELA_SECRET_ACCESS_KEY=
AWS_VIKELA_REGION=us-east-1
AWS_EXTERNAL_ID=vikela-scanner
AWS_S3_ACCESS_KEY_ID=
AWS_S3_BUCKET=vikela-evidence
CLOUD_SCAN_CRON=0 2 * * *

AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID
AZURE_CLIENT_ID=YOUR_AZURE_CLIENT_ID
# Secret Value from Certificates & secrets (NOT the Secret ID GUID)
AZURE_CLIENT_SECRET=replace-me
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/azure/callback
AZURE_CLOUD_REDIRECT_URI=http://localhost:3000/api/auth/azure-cloud/callback

GCP_CLIENT_ID=YOUR_GCP_CLIENT_ID.apps.googleusercontent.com
GCP_CLIENT_SECRET=replace-me
GCP_REDIRECT_URI=http://localhost:3000/api/auth/gcp-cloud/callback
GCP_CLOUD_REDIRECT_URI=http://localhost:3000/api/auth/gcp-cloud/callback
# Optional: skip project listing if Cloud Resource Manager API is blocked
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_PROJECT_NAME=My Project

# ── Coming soon: Cloud (Phase 3) ─────────────────────────────────────────────
DO_CLIENT_ID=
DO_CLIENT_SECRET=
DO_REDIRECT_URI=http://localhost:3000/api/auth/digitalocean/callback

# Cloudflare connect uses a customer API token (dialog), no Vikela CF OAuth app required.
# Legacy OAuth placeholders (unused by current connect flow):
# CF_CLIENT_ID=
# CF_CLIENT_SECRET=
# CF_REDIRECT_URI=http://localhost:3000/api/auth/cloudflare/callback

ORACLE_TENANCY_OCID=
ORACLE_USER_OCID=
ORACLE_FINGERPRINT=
ORACLE_PRIVATE_KEY=
ORACLE_REGION=us-ashburn-1
ORACLE_CLIENT_ID=
ORACLE_CLIENT_SECRET=
ORACLE_REDIRECT_URI=http://localhost:3000/api/auth/oracle/callback

ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_REGION=cn-hangzhou
ALIBABA_CLIENT_ID=
ALIBABA_CLIENT_SECRET=
ALIBABA_REDIRECT_URI=http://localhost:3000/api/auth/alibaba/callback

# Identity
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_REDIRECT_URI=http://localhost:3000/api/auth/okta/callback

AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/auth/azure-ad/callback

GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:3000/api/auth/google-workspace/callback

# ── Auth0 (Management API M2M. Connect Auth0 on Integrations) ───────────────
# Domain is entered in the Connect dialog; optional default:
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=http://localhost:3000/api/auth/auth0/callback
# Machine-to-Machine app authorized for Auth0 Management API (read:users)
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

IDENTITY_SCAN_CRON=0 3 * * *

# ── Observability ────────────────────────────────────────────────────────────
# Datadog connect uses customer API + Application keys in the Integrations UI, # no platform DATADOG_* secrets are required for multi-tenant connect.
# Legacy placeholders (unused by current connect flow):
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
# DATADOG_SITE=datadoghq.com

# Grafana connect uses customer base URL + service account token in the Integrations UI.
# Legacy placeholders (unused by current connect flow):
# GRAFANA_URL=
# GRAFANA_API_TOKEN=

# PagerDuty connect uses a customer REST API token in the Integrations UI, # no platform PagerDuty OAuth app is required for the current connect flow.
# Legacy OAuth placeholders (unused):
# PAGERDUTY_CLIENT_ID=
# PAGERDUTY_CLIENT_SECRET=
# PAGERDUTY_REDIRECT_URI=http://localhost:3000/api/auth/pagerduty/callback

# New Relic connect uses a customer User API key in the Integrations UI, # no platform NEW_RELIC_* secrets are required for multi-tenant connect.
# Legacy placeholders (unused by current connect flow):
# NEW_RELIC_ACCOUNT_ID=
# NEW_RELIC_USER_API_KEY=
# NEW_RELIC_REGION=US

# ── Communication ────────────────────────────────────────────────────────────
# Slack OAuth app (api.slack.com/apps). Redirect URL must match SLACK_REDIRECT_URI.
# Bot scopes: chat:write, channels:read, groups:read, team:read, incoming-webhook
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/auth/slack/callback

# Microsoft Teams connect uses a channel Incoming Webhook / Workflow URL in the UI, # no platform MICROSOFT_TEAMS_* OAuth secrets are required for the current connect flow.
# Legacy OAuth placeholders (unused):
# MICROSOFT_TEAMS_CLIENT_ID=
# MICROSOFT_TEAMS_CLIENT_SECRET=
# MICROSOFT_TEAMS_TENANT_ID=
# MICROSOFT_TEAMS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft-teams/callback

# Evidence uploads (local dev)
EVIDENCE_UPLOAD_DIR=./uploads

# Vikela evidence storage (not customer AWS)
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=vikela-evidence

RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=onboarding@example.com

# Billing (Stripe), monthly + annual (~17% off) price IDs
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_SOLO=price_REPLACE_ME_SOLO
STRIPE_PRICE_SOLO_ANNUAL=price_REPLACE_ME_SOLO_ANNUAL
STRIPE_PRICE_STARTER=price_REPLACE_ME_STARTER
STRIPE_PRICE_STARTER_ANNUAL=price_REPLACE_ME_STARTER_ANNUAL
STRIPE_PRICE_GROWTH=price_REPLACE_ME_GROWTH
STRIPE_PRICE_GROWTH_ANNUAL=price_REPLACE_ME_GROWTH_ANNUAL

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
PRODUCT_EVENTS_WEBHOOK_URL=

# RAG embeddings (optional, falls back to keyword search)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dev toggles
PORT=3001
DISABLE_SCAN_WORKER=false

# E2E / CI (optional locally)
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_URL=http://localhost:3001

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
