# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
ENCRYPTION_KEY=                    # openssl rand -hex 32

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vikela
# Supabase: use pooler for DATABASE_URL; DIRECT_URL = session pooler :5432 (see Supabase → Connect)
DIRECT_URL=
REDIS_URL=redis://localhost:6379

# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Dev: allow demo integration tokens (never set true in production)
ALLOW_DEMO_INTEGRATIONS=true
# Optional server-to-server secret (Next.js → API without user session)
INTERNAL_API_SECRET=
VIKELA_DEV_ORG_SLUG=demo
API_RATE_LIMIT_MAX=300
# Comma-separated extra CORS origins for staging/production web URLs
CORS_ALLOWED_ORIGINS=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/connect-repos

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Git Providers
GITHUB_APP_ID=
# Full PEM from GitHub App → Generate private key (not the SHA256 fingerprint)
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=vikela1
# OAuth fallback when App install is unavailable (private app or missing PEM)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

GITLAB_APP_ID=
GITLAB_APP_SECRET=
GITLAB_WEBHOOK_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/api/auth/gitlab/callback

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_WEBHOOK_SECRET=
BITBUCKET_REDIRECT_URI=http://localhost:3000/api/auth/bitbucket/callback

# Cloud — Vikela account for AWS AssumeRole only
AWS_VIKELA_ACCOUNT_ID=
AWS_VIKELA_ACCESS_KEY_ID=
AWS_VIKELA_SECRET_ACCESS_KEY=
AWS_VIKELA_REGION=us-east-1
AWS_EXTERNAL_ID=vikela-scanner
CLOUD_SCAN_CRON=0 2 * * *

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/azure/callback
AZURE_CLOUD_REDIRECT_URI=http://localhost:3000/api/auth/azure-cloud/callback

GCP_CLIENT_ID=
GCP_CLIENT_SECRET=
GCP_REDIRECT_URI=http://localhost:3000/api/auth/gcp/callback
GCP_CLOUD_REDIRECT_URI=http://localhost:3000/api/auth/gcp-cloud/callback

DO_CLIENT_ID=
DO_CLIENT_SECRET=
DO_REDIRECT_URI=http://localhost:3000/api/auth/digitalocean/callback

CF_CLIENT_ID=
CF_CLIENT_SECRET=

# Identity
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_REDIRECT_URI=http://localhost:3000/api/auth/okta/callback

AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/auth/azure-ad/callback

GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:3000/api/auth/google-workspace/callback

AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

IDENTITY_SCAN_CRON=0 3 * * *

# Evidence uploads (local dev)
EVIDENCE_UPLOAD_DIR=

# Vikela evidence storage (not customer AWS)
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=vikela-evidence

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@vikela.com

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
PRODUCT_EVENTS_WEBHOOK_URL=

# RAG embeddings (optional — falls back to keyword search)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dev toggles
PORT=3001
DISABLE_SCAN_WORKER=

# E2E / CI (optional locally)
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_URL=http://localhost:3001

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
